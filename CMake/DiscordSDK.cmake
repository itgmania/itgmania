# SDK archives are supplied through Discord's Developer Portal.
option(WITH_DISCORD_SDK "Build Discord Social SDK rich presence" OFF)
set(DISCORD_SDK_ROOT "" CACHE PATH "Extracted Discord Social SDK C++ directory")
if(WITH_DISCORD_SDK)
  if(WIN32 AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Discord Social SDK requires a 64-bit Windows build")
  endif()
  find_path(DISCORD_SDK_INCLUDE_DIR discordpp.h PATHS "${DISCORD_SDK_ROOT}/include" NO_DEFAULT_PATH REQUIRED)
  find_library(DISCORD_SDK_LIBRARY NAMES discord_partner_sdk PATHS "${DISCORD_SDK_ROOT}/lib/release" NO_DEFAULT_PATH REQUIRED)
  if(WIN32)
    set(DISCORD_SDK_RUNTIME "${DISCORD_SDK_ROOT}/bin/release/discord_partner_sdk.dll")
  elseif(APPLE)
    set(DISCORD_SDK_RUNTIME "${DISCORD_SDK_ROOT}/lib/release/libdiscord_partner_sdk.dylib")
  else()
    set(DISCORD_SDK_RUNTIME "${DISCORD_SDK_ROOT}/lib/release/libdiscord_partner_sdk.so")
  endif()
  if(NOT EXISTS "${DISCORD_SDK_RUNTIME}")
    message(FATAL_ERROR "Discord SDK runtime not found: ${DISCORD_SDK_RUNTIME}")
  endif()
  set(DISCORD_SDK_NOTICES "${DISCORD_SDK_ROOT}/License-Notices.txt")
  add_library(itgmania_discord STATIC DiscordSDK.cpp)
  set_target_properties(itgmania_discord PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
  target_include_directories(itgmania_discord PRIVATE "${DISCORD_SDK_INCLUDE_DIR}")
  target_link_libraries(itgmania_discord PUBLIC "${DISCORD_SDK_LIBRARY}")
  set_source_files_properties(DiscordManager.cpp PROPERTIES COMPILE_DEFINITIONS WITH_DISCORD_SDK)
  target_link_libraries(itgmania_core PUBLIC itgmania_discord)
  if(APPLE)
    set_property(TARGET "${SM_EXE_NAME}" APPEND PROPERTY BUILD_RPATH "@loader_path")
    set_property(TARGET "${SM_EXE_NAME}" APPEND PROPERTY INSTALL_RPATH "@loader_path")
  elseif(UNIX)
    set_property(TARGET "${SM_EXE_NAME}" APPEND PROPERTY BUILD_RPATH "$ORIGIN")
    set_property(TARGET "${SM_EXE_NAME}" APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
  endif()
endif()

function(sm_copy_discord_runtime target)
  if(WITH_DISCORD_SDK)
    add_custom_command(TARGET "${target}" POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${DISCORD_SDK_RUNTIME}" "$<TARGET_FILE_DIR:${target}>"
      VERBATIM)
    if(EXISTS "${DISCORD_SDK_NOTICES}")
      add_custom_command(TARGET "${target}" POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${DISCORD_SDK_NOTICES}"
          "$<TARGET_FILE_DIR:${target}>/Discord-SDK-Notices.txt"
        VERBATIM)
    endif()
  endif()
endfunction()
